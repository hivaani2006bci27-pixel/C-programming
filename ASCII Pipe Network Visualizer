#include <stdio.h>
#define ROWS 7
#define COLS 15
int main() 
{
    char map[ROWS][COLS];
    for (int i = 0; i < ROWS; i++)
{
        for (int j = 0; j < COLS; j++)
{
            map[i][j] = ' ';
        }
    }
    for (int j = 1; j < 14; j++) map[3][j] = '=';
    map[1][4] = '|'; map[2][4] = '|';
    map[1][10] = '|'; map[2][10] = '|';
    map[4][7] = '|'; map[5][7] = '|';
    map[3][4] = 'O'; map[3][10] = 'O'; map[3][7] = 'O';
    map[3][0] = 'S'; // S = Source
    map[1][4] = 'T'; // T = Tank 1
    map[1][10] = 'T'; // T = Tank 2
    map[5][7] = 'H'; // H = Home supply
    printf("=== CSE Visualizer: Interactive Water Distribution Layout ===\n\n");
    for (int i = 0; i < ROWS; i++) 
{
        printf("\t");
        for (int j = 0; j < COLS; j++)
{
            printf("%c", map[i][j]);
        }
        printf("\n");
    }
    printf("\nLegend: S=Source Pump, O=Control Valve, ===/|||=Pipes, T/H=Endpoints\n");
    return 0;
}
